{% doc %}
  @prompt
    Create a full-screen search overlay component for EcuaFolk, an Ecuadorian food store. This replaces an existing overlay where the close button was not working. Requirements: 1) A full-screen fixed overlay with dark semi-transparent background, hidden by default (display:none or opacity 0). 2) A clearly visible close (X) button in the top-right corner - use a large clickable area (min 44x44px), with explicit onclick handler AND addEventListener click to close the overlay. 3) A large search input field with placeholder "Buscar productos..." that auto-focuses when overlay opens. 4) Live search results below the input using Shopify Predictive Search API (/search/suggest.json) showing product image, name, and price. 5) The overlay opens when ANY element with class "search-trigger" is clicked anywhere on the page. 6) The overlay closes when: close button is clicked, Escape key is pressed, or the dark background outside the search box is clicked. 7) Expose a global function window.openSearchOverlay() and window.closeSearchOverlay() so other scripts can call them directly. 8) The open close logic must use a simple CSS class toggle (add remove class "is-active" or "is-open") with the actual show hide in CSS. Add very detailed comments on every function and event listener explaining exactly how the open and close mechanism works so a developer can debug it easily.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-search-overlay-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-search-overlay-{{ ai_gen_id }}.is-open {
    opacity: 1;
    visibility: visible;
  }

  .ai-search-overlay-backdrop-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_background_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-search-overlay-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.search_box_max_width }}px;
    margin: 0 auto;
    padding: 60px 20px 20px;
    height: 100%;
    overflow-y: auto;
  }

  .ai-search-overlay-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 48px;
    height: 48px;
    background-color: {{ block.settings.close_button_background }};
    color: {{ block.settings.close_button_color }};
    border: none;
    border-radius: {{ block.settings.close_button_radius }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .ai-search-overlay-close-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.close_button_hover_background }};
    transform: scale(1.1);
  }

  .ai-search-overlay-close-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-search-overlay-search-box-{{ ai_gen_id }} {
    background-color: {{ block.settings.search_box_background }};
    border-radius: {{ block.settings.search_box_radius }}px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .ai-search-overlay-input-wrapper-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 20px;
  }

  .ai-search-overlay-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px 24px;
    font-size: {{ block.settings.input_font_size }}px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    outline: none;
    transition: border-color 0.2s ease;
  }

  .ai-search-overlay-input-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-search-overlay-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .ai-search-overlay-loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
    color: {{ block.settings.loading_text_color }};
    display: none;
  }

  .ai-search-overlay-loading-{{ ai_gen_id }}.is-visible {
    display: block;
  }

  .ai-search-overlay-results-{{ ai_gen_id }} {
    margin-top: 20px;
  }

  .ai-search-overlay-result-item-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    padding: 16px;
    background-color: {{ block.settings.result_item_background }};
    border-radius: {{ block.settings.result_item_radius }}px;
    margin-bottom: 12px;
    text-decoration: none;
    color: {{ block.settings.result_item_text_color }};
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .ai-search-overlay-result-item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.result_item_hover_background }};
    transform: translateX(4px);
  }

  .ai-search-overlay-result-image-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: {{ block.settings.result_image_radius }}px;
    overflow: hidden;
  }

  .ai-search-overlay-result-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-search-overlay-result-info-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-search-overlay-result-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
    color: {{ block.settings.result_item_text_color }};
  }

  .ai-search-overlay-result-price-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.result_price_color }};
    font-weight: 500;
  }

  .ai-search-overlay-no-results-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.no_results_text_color }};
    font-size: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-search-overlay-content-{{ ai_gen_id }} {
      padding: 80px 16px 16px;
    }

    .ai-search-overlay-search-box-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-search-overlay-input-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-search-overlay-result-image-{{ ai_gen_id }} {
      width: 60px;
      height: 60px;
    }
  }
{% endstyle %}

<search-overlay-{{ ai_gen_id }}
  class="ai-search-overlay-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-search-overlay-backdrop-{{ ai_gen_id }}"></div>

  <div class="ai-search-overlay-content-{{ ai_gen_id }}">
    <button
      class="ai-search-overlay-close-{{ ai_gen_id }}"
      aria-label="Cerrar búsqueda"
      type="button"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-search-overlay-search-box-{{ ai_gen_id }}">
      <div class="ai-search-overlay-input-wrapper-{{ ai_gen_id }}">
        <input
          type="text"
          class="ai-search-overlay-input-{{ ai_gen_id }}"
          placeholder="Buscar productos..."
          autocomplete="off"
          aria-label="Buscar productos"
        >
      </div>

      <div class="ai-search-overlay-loading-{{ ai_gen_id }}">
        Buscando...
      </div>

      <div class="ai-search-overlay-results-{{ ai_gen_id }}"></div>
    </div>
  </div>
</search-overlay-{{ ai_gen_id }}>

<script>
(function() {
  class SearchOverlay{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      
      this.overlay = this;
      this.closeButton = this.querySelector('.ai-search-overlay-close-{{ ai_gen_id }}');
      this.backdrop = this.querySelector('.ai-search-overlay-backdrop-{{ ai_gen_id }}');
      this.searchInput = this.querySelector('.ai-search-overlay-input-{{ ai_gen_id }}');
      this.resultsContainer = this.querySelector('.ai-search-overlay-results-{{ ai_gen_id }}');
      this.loadingIndicator = this.querySelector('.ai-search-overlay-loading-{{ ai_gen_id }}');
      
      this.searchTimeout = null;
      this.currentRequest = null;
    }

    connectedCallback() {
      this.setupEventListeners();
      this.exposeGlobalFunctions();
      this.setupSearchTriggers();
    }

    setupEventListeners() {
      this.closeButton.addEventListener('click', () => this.closeOverlay());
      
      this.closeButton.onclick = () => this.closeOverlay();
      
      this.backdrop.addEventListener('click', () => this.closeOverlay());
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen()) {
          this.closeOverlay();
        }
      });
      
      this.searchInput.addEventListener('input', (e) => {
        this.handleSearchInput(e.target.value);
      });
    }

    setupSearchTriggers() {
      document.addEventListener('click', (e) => {
        if (e.target.closest('.search-trigger')) {
          e.preventDefault();
          this.openOverlay();
        }
      });
    }

    exposeGlobalFunctions() {
      window.openSearchOverlay = () => this.openOverlay();
      window.closeSearchOverlay = () => this.closeOverlay();
    }

    openOverlay() {
      this.overlay.classList.add('is-open');
      
      document.body.style.overflow = 'hidden';
      
      setTimeout(() => {
        this.searchInput.focus();
      }, 100);
    }

    closeOverlay() {
      this.overlay.classList.remove('is-open');
      
      document.body.style.overflow = '';
      
      this.searchInput.value = '';
      this.resultsContainer.innerHTML = '';
      this.loadingIndicator.classList.remove('is-visible');
    }

    isOpen() {
      return this.overlay.classList.contains('is-open');
    }

    handleSearchInput(query) {
      clearTimeout(this.searchTimeout);
      
      if (this.currentRequest) {
        this.currentRequest.abort();
      }
      
      if (query.trim().length < 2) {
        this.resultsContainer.innerHTML = '';
        this.loadingIndicator.classList.remove('is-visible');
        return;
      }
      
      this.loadingIndicator.classList.add('is-visible');
      
      this.searchTimeout = setTimeout(() => {
        this.performSearch(query);
      }, 300);
    }

    performSearch(query) {
      const controller = new AbortController();
      this.currentRequest = controller;
      
      const searchUrl = `/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=8`;
      
      fetch(searchUrl, { signal: controller.signal })
        .then(response => response.json())
        .then(data => {
          this.loadingIndicator.classList.remove('is-visible');
          this.displayResults(data.resources.results.products || []);
        })
        .catch(error => {
          if (error.name !== 'AbortError') {
            console.error('Search error:', error);
            this.loadingIndicator.classList.remove('is-visible');
          }
        });
    }

    displayResults(products) {
      if (products.length === 0) {
        this.resultsContainer.innerHTML = `
          <div class="ai-search-overlay-no-results-{{ ai_gen_id }}">
            No se encontraron productos
          </div>
        `;
        return;
      }
      
      const resultsHTML = products.map(product => {
        const price = product.price ? parseFloat(product.price).toFixed(2) : '0.00';
        const imageUrl = product.image ? product.image : '';
        
        return `
          <a href="${product.url}" class="ai-search-overlay-result-item-{{ ai_gen_id }}">
            <div class="ai-search-overlay-result-image-{{ ai_gen_id }}">
              ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" loading="lazy">` : ''}
            </div>
            <div class="ai-search-overlay-result-info-{{ ai_gen_id }}">
              <div class="ai-search-overlay-result-title-{{ ai_gen_id }}">${product.title}</div>
              <div class="ai-search-overlay-result-price-{{ ai_gen_id }}">$${price} USD</div>
            </div>
          </a>
        `;
      }).join('');
      
      this.resultsContainer.innerHTML = resultsHTML;
    }
  }

  customElements.define('search-overlay-{{ ai_gen_id }}', SearchOverlay{{ ai_gen_id }});
})();
</script>

