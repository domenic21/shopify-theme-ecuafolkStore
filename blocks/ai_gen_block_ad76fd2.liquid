{% doc %}
  @prompt
    Create a mobile-first featured collection section for EcuaFolk, an Ecuadorian food store. Display products in a 2-column grid on mobile and 4-column grid on desktop. Each product card should show: product image, product name, price, and a red "Agregar al carrito" button that uses Shopify Ajax Cart API to add the product without page reload. Include a section title "Colección destacada" and a "Ver todo" link. Include theme editor settings to select which collection to display and how many products to show. Add detailed code comments throughout explaining every Liquid tag, CSS class, schema setting, and JavaScript function so a developer can understand and modify the code easily., ADD BORDERS TO EACH CARD 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px 16px;
  }

  .ai-featured-collection__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-featured-collection__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .ai-featured-collection__title-{{ ai_gen_id }} {
    font-size: 24px; 
    font-weight: 700;
    margin: 0;
    color: {{ block.settings.title_color }};
  }

  .ai-featured-collection__view-all-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    transition: opacity 0.3s ease;
  }

  .ai-featured-collection__view-all-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .ai-featured-collection__product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-featured-collection__product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection__product-info-{{ ai_gen_id }} {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.product_title_color }};
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-featured-collection__product-price-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 16px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 16px;
  }

  .ai-featured-collection__qty-wrap-{{ ai_gen_id }} {
    display: none;
    align-items: center;
    width: 100%;
    border: 2px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.button_border_radius }}px;
    overflow: hidden;
    margin-top: auto;
  }

  .ai-featured-collection__qty-btn-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    font-size: 20px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }

  .ai-featured-collection__qty-btn-{{ ai_gen_id }}:hover {
    opacity: 0.85;
  }

  .ai-featured-collection__qty-display-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: {{ block.settings.button_background }};
    padding: 0 4px;
  }

  @media screen and (min-width: 750px) {
    .ai-featured-collection-{{ ai_gen_id }} {
      padding: 40px 24px;
    }

    .ai-featured-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .ai-featured-collection__title-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-featured-collection__view-all-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-featured-collection__product-title-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-featured-collection__product-price-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-featured-collection__add-to-cart-{{ ai_gen_id }} {
      font-size: 16px;
      padding: 12px 20px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if block.settings.collection != blank %}
      {% assign collection = block.settings.collection %}
      
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">
          {{ block.settings.section_title }}
        </h2>
        <a href="{{ collection.url }}" class="ai-featured-collection__view-all-{{ ai_gen_id }}">
          {{ block.settings.view_all_text }}
        </a>
      </div>

      {% if collection.products.size > 0 %}
        <div class="ai-featured-collection__grid-{{ ai_gen_id }}">
          {% for product in collection.products limit: block.settings.products_to_show %}
            <div class="ai-featured-collection__product-card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-featured-collection__product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                            {{ product.featured_image | image_url: width: 600 }} 600w,
                            {{ product.featured_image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 750px) 25vw, 50vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    class="ai-featured-collection__product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-featured-collection__product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>

              <div class="ai-featured-collection__product-info-{{ ai_gen_id }}">
                <a href="{{ product.url }}" style="text-decoration: none;">
                  <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">
                    {{ product.title }}
                  </h3>
                </a>

                <p class="ai-featured-collection__product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </p>

                <div
                  class="ai-featured-collection__cart-area-{{ ai_gen_id }}"
                  data-cart-area
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                >
                  <button
                    class="ai-featured-collection__add-to-cart-{{ ai_gen_id }}"
                    data-product-id="{{ product.id }}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    {% unless product.available %}disabled{% endunless %}
                  >
                    {% if product.available %}
                      {{ block.settings.button_text }}
                    {% else %}
                      Agotado
                    {% endif %}
                  </button>
                  <div class="ai-featured-collection__qty-wrap-{{ ai_gen_id }}" data-qty-wrap>
                    <button type="button" class="ai-featured-collection__qty-btn-{{ ai_gen_id }}" data-qty-decrease>&#8722;</button>
                    <span class="ai-featured-collection__qty-display-{{ ai_gen_id }}" data-qty-display>1</span>
                    <button type="button" class="ai-featured-collection__qty-btn-{{ ai_gen_id }}" data-qty-increase>&#43;</button>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
          <p>Esta colección no tiene productos.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
        <p>Selecciona una colección en la configuración del bloque.</p>
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.cartAreas = this.querySelectorAll('[data-cart-area]');
        this.setupEventListeners();
        this.initCartState();
      }

      setupEventListeners() {
        this.cartAreas.forEach((area) => {
          const atcBtn = area.querySelector('.ai-featured-collection__add-to-cart-{{ ai_gen_id }}');
          const decreaseBtn = area.querySelector('[data-qty-decrease]');
          const increaseBtn = area.querySelector('[data-qty-increase]');
          if (atcBtn) atcBtn.addEventListener('click', (e) => this.handleAddToCart(e, area));
          if (decreaseBtn) decreaseBtn.addEventListener('click', () => this.handleQtyChange(area, -1));
          if (increaseBtn) increaseBtn.addEventListener('click', () => this.handleQtyChange(area, 1));
        });
      }

      async initCartState() {
        try {
          const res = await fetch('/cart.js');
          const cart = await res.json();
          this.cartAreas.forEach((area) => {
            const variantId = parseInt(area.dataset.variantId);
            const item = cart.items.find(i => i.variant_id === variantId);
            if (item && item.quantity > 0) this.showStepper(area, item.quantity);
          });
        } catch(e) {}
      }

      async handleAddToCart(event, area) {
        const button = area.querySelector('.ai-featured-collection__add-to-cart-{{ ai_gen_id }}');
        const variantId = area.dataset.variantId;
        if (!variantId || button.disabled) return;
        const originalText = button.textContent.trim();
        button.disabled = true;
        button.textContent = 'Agregando...';
        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          });
          if (!res.ok) throw new Error();
          this.showStepper(area, 1);
          this.refreshCartBadge();
        } catch(error) {
          button.textContent = 'Error';
          setTimeout(() => { button.textContent = originalText; button.disabled = false; }, 2000);
        }
      }

      async handleQtyChange(area, delta) {
        const qtyDisplay = area.querySelector('[data-qty-display]');
        const variantId = area.dataset.variantId;
        const currentQty = parseInt(qtyDisplay.textContent) || 0;
        const newQty = Math.max(0, currentQty + delta);
        if (newQty === 0) {
          this.showAtcButton(area);
        } else {
          qtyDisplay.textContent = newQty;
        }
        try {
          await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: newQty })
          });
          this.refreshCartBadge();
        } catch(e) {
          if (newQty === 0) { this.showStepper(area, currentQty); }
          else { qtyDisplay.textContent = currentQty; }
        }
      }

      showStepper(area, qty) {
        const atcBtn = area.querySelector('.ai-featured-collection__add-to-cart-{{ ai_gen_id }}');
        const qtyWrap = area.querySelector('[data-qty-wrap]');
        const qtyDisplay = area.querySelector('[data-qty-display]');
        atcBtn.style.display = 'none';
        qtyDisplay.textContent = qty;
        qtyWrap.style.display = 'flex';
      }

      showAtcButton(area) {
        const atcBtn = area.querySelector('.ai-featured-collection__add-to-cart-{{ ai_gen_id }}');
        const qtyWrap = area.querySelector('[data-qty-wrap]');
        qtyWrap.style.display = 'none';
        atcBtn.style.display = '';
        atcBtn.disabled = false;
      }

      async refreshCartBadge() {
        try {
          const res = await fetch('/cart.js');
          const cart = await res.json();
          document.querySelectorAll('[data-cart-badge]').forEach(el => {
            el.textContent = cart.item_count;
            el.style.display = cart.item_count > 0 ? '' : 'none';
          });
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        } catch(e) {}
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Colección destacada",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "inline_richtext",
      "id": "section_title",
      "label": "Título de la sección",
      "default": "Colección destacada"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Productos a mostrar",
      "default": 8
    },
    {
      "type": "inline_richtext",
      "id": "view_all_text",
      "label": "Texto del enlace",
      "default": "Ver todo"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Agregar al carrito"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color del enlace",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fondo de la tarjeta",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Color del título del producto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color del precio",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo del botón",
      "default": "#dc143c"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Fondo del botón al pasar el cursor",
      "default": "#b01030"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color del texto del botón",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Bordes de tarjeta"
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Grosor del borde",
      "default": 1
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color del borde",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Radio del borde de la tarjeta",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Radio del borde del botón",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Colección destacada"
    }
  ]
}
{% endschema %}
