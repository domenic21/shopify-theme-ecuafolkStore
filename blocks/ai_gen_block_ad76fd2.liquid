    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Productos a mostrar",
      "default": 8
    },
    {
      "type": "inline_richtext",
      "id": "view_all_text",
      "label": "Texto del enlace",
      "default": "Ver todo"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Agregar al carrito"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color del enlace",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fondo de la tarjeta",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Color del título del producto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color del precio",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo del botón",
      "default": "#dc143c"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Fondo del botón al pasar el cursor",
      "default": "#b01030"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color del texto del botón",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Bordes de tarjeta"
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Grosor del borde",
      "default": 1
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color del borde",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Radio del borde de la tarjeta",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Radio del borde del botón",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Colección destacada"
    }
  ]
}
{% endschema %}
