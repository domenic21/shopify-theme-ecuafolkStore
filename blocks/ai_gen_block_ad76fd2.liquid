{% doc %}
  @prompt
    Create a mobile-first featured collection section for EcuaFolk, an Ecuadorian food store. Display products in a 2-column grid on mobile and 4-column grid on desktop. Each product card should show: product image, product name, price, and a red "Agregar al carrito" button that uses Shopify Ajax Cart API to add the product without page reload. Include a section title "Colección destacada" and a "Ver todo" link. Include theme editor settings to select which collection to display and how many products to show. Add detailed code comments throughout explaining every Liquid tag, CSS class, schema setting, and JavaScript function so a developer can understand and modify the code easily., ADD BORDERS TO EACH CARD 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px 16px;
  }

  .ai-featured-collection__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-featured-collection__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .ai-featured-collection__title-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    margin: 0;
    color: {{ block.settings.title_color }};
  }

  .ai-featured-collection__view-all-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    transition: opacity 0.3s ease;
  }

  .ai-featured-collection__view-all-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .ai-featured-collection__product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-featured-collection__product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection__product-info-{{ ai_gen_id }} {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.product_title_color }};
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-featured-collection__product-price-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 16px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 16px;
  }

  @media screen and (min-width: 750px) {
    .ai-featured-collection-{{ ai_gen_id }} {
      padding: 40px 24px;
    }

    .ai-featured-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .ai-featured-collection__title-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-featured-collection__view-all-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-featured-collection__product-title-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-featured-collection__product-price-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-featured-collection__add-to-cart-{{ ai_gen_id }} {
      font-size: 16px;
      padding: 12px 20px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if block.settings.collection != blank %}
      {% assign collection = block.settings.collection %}
      
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">
          {{ block.settings.section_title }}
        </h2>
        <a href="{{ collection.url }}" class="ai-featured-collection__view-all-{{ ai_gen_id }}">
          {{ block.settings.view_all_text }}
        </a>
      </div>

      {% if collection.products.size > 0 %}
        <div class="ai-featured-collection__grid-{{ ai_gen_id }}">
          {% for product in collection.products limit: block.settings.products_to_show %}
            <div class="ai-featured-collection__product-card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-featured-collection__product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-featured-collection__product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-featured-collection__product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>

              <div class="ai-featured-collection__product-info-{{ ai_gen_id }}">
                <a href="{{ product.url }}" style="text-decoration: none;">
                  <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">
                    {{ product.title }}
                  </h3>
                </a>

                <p class="ai-featured-collection__product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </p>

                <button
                  class="ai-featured-collection__add-to-cart-{{ ai_gen_id }}"
                  data-product-id="{{ product.id }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ block.settings.button_text }}
                  {% else %}
                    Agotado
                  {% endif %}
                </button>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
          <p>Esta colección no tiene productos.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
        <p>Selecciona una colección en la configuración del bloque.</p>
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-featured-collection__add-to-cart-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      async handleAddToCart(event) {
        const button = event.target;
        const variantId = button.getAttribute('data-variant-id');
        
        if (!variantId || button.disabled) {
          return;
        }

        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Agregando...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (!response.ok) {
            throw new Error('Error al agregar al carrito');
          }

          const data = await response.json();
          
          button.textContent = '¡Agregado!';
          
          this.updateCartCount();
          
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

        } catch (error) {
          console.error('Error:', error);
          button.textContent = 'Error';
          
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }

      async updateCartCount() {
        try {
          const response = await fetch('/cart.js');
          const cart = await response.json();
          
          const cartCountElements = document.querySelectorAll('.cart-count-bubble span, [data-cart-count]');
          cartCountElements.forEach((element) => {
            element.textContent = cart.item_count;
          });

          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
            bubbles: true
          }));
        } catch (error) {
          console.error('Error updating cart count:', error);
        }
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Colección destacada",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "inline_richtext",
      "id": "section_title",
      "label": "Título de la sección",
      "default": "Colección destacada"
