      "id": "button_text",
      "label": "Button text",
      "default": "Ver Catálogo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_vertical_position",
      "label": "Button vertical position",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "button_bg_color",
