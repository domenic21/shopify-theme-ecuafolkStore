<script>
  (function() {
    class EcuafolkHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.hamburger = this.querySelector('.ai-ecuafolk-header__hamburger-{{ ai_gen_id }}');
        this.languageToggle = this.querySelector('[data-language-toggle]');
        this.languageDropdown = this.querySelector('[data-language-dropdown]');
        this.languageOptions = this.querySelectorAll('[data-language]');
        this.mobileMenuToggle = this.querySelector('[data-mobile-menu-toggle]');
        this.mobileMenu = this.querySelector('[data-mobile-menu]');
        this.mobileMenuClose = this.querySelector('[data-mobile-menu-close]');
        this.mobileOverlay = this.querySelector('[data-mobile-overlay]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.hamburger) {
          this.hamburger.addEventListener('click', () => {
            const isExpanded = this.hamburger.getAttribute('aria-expanded') === 'true';
            this.hamburger.setAttribute('aria-expanded', !isExpanded);
          });
        }

        if (this.languageToggle && this.languageDropdown) {
          this.languageToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const isExpanded = this.languageToggle.getAttribute('aria-expanded') === 'true';
            this.languageToggle.setAttribute('aria-expanded', !isExpanded);
            this.languageDropdown.classList.toggle('active');
          });

          document.addEventListener('click', (e) => {
            if (!this.contains(e.target)) {
              this.languageToggle.setAttribute('aria-expanded', 'false');
              this.languageDropdown.classList.remove('active');
            }
          });
        }

        this.languageOptions.forEach(option => {
          option.addEventListener('click', () => {
            const languageCode = option.getAttribute('data-language');
            this.languageOptions.forEach(opt => opt.classList.remove('active'));
            option.classList.add('active');
            
            const languageText = this.languageToggle.querySelector('span');
            if (languageText) {
              languageText.textContent = languageCode;
            }
            
            this.languageToggle.setAttribute('aria-expanded', 'false');
            this.languageDropdown.classList.remove('active');

            // Submit Shopify localization form to actually switch the language
            const localeInput = document.getElementById('locale-code-{{ ai_gen_id }}');
            const localizationForm = document.getElementById('localization-form-{{ ai_gen_id }}');
            if (localeInput && localizationForm) {
              localeInput.value = languageCode;
              localizationForm.submit();
            }
          });
        });

        if (this.mobileMenuToggle && this.mobileMenu && this.mobileOverlay) {
          this.mobileMenuToggle.addEventListener('click', () => {
            this.openMobileMenu();
          });

          this.mobileMenuClose.addEventListener('click', () => {
            this.closeMobileMenu();
          });

          this.mobileOverlay.addEventListener('click', () => {
            this.closeMobileMenu();
          });
        }
      }

      openMobileMenu() {
        this.mobileMenu.classList.add('active');
        this.mobileOverlay.classList.add('active');
        this.mobileMenuToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      closeMobileMenu() {
        this.mobileMenu.classList.remove('active');
        this.mobileOverlay.classList.remove('active');
        this.mobileMenuToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }

    customElements.define('ecuafolk-header-{{ ai_gen_id }}', EcuafolkHeader{{ ai_gen_id }});
  })();
</script>

